[Unit]
Description=Melissa local Kokoro speech worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ClaudeCodeWorkspace/YourEnglishTeacher
EnvironmentFile=/home/ubuntu/ClaudeCodeWorkspace/YourEnglishTeacher/.env.speech
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/home/ubuntu/ClaudeCodeWorkspace/YourEnglishTeacher/.data/speech/venv/bin/python -m services.speech.worker
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1/8
UMask=0077
MemoryMax=2G
CPUQuota=200%
TasksMax=32

[Install]
WantedBy=multi-user.target
