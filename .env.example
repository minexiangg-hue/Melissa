# No credentials are needed. Only demo providers are implemented.
TEACHER_PROVIDER=demo
DATABASE_PATH=.data/teacher.db
# Local-only default. Match the browser origin exactly (including port).
APP_ORIGIN=http://127.0.0.1:3000
# Optional URL prefix. Set the same value at build time and runtime.
NEXT_PUBLIC_BASE_PATH=
# Set true behind HTTPS. Guest cookies are HttpOnly and SameSite=Strict.
COOKIE_SECURE=false
# Per guest / UTC day; deterministic demo units, NOT measured model tokens.
DAILY_DEMO_UNIT_LIMIT=15000
PROVIDER_TIMEOUT_MS=10000
