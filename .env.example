# demo runs offline. codex uses a local authenticated Codex CLI.
# openai-compatible calls the configured external Chat Completions API.
TEACHER_PROVIDER=demo
DATABASE_PATH=.data/teacher.db
# Local-only default. Match the browser origin exactly (including port).
APP_ORIGIN=http://127.0.0.1:3000
# Optional URL prefix. Set the same value at build time and runtime.
NEXT_PUBLIC_BASE_PATH=
# Separate production output from development/test .next if desired.
MELISSA_BUILD_DIR=.next
COOKIE_SECURE=false
# Application practice units; these are not billed model tokens.
DAILY_DEMO_UNIT_LIMIT=15000
# A failed/uncertain AI attempt also consumes a request allowance.
DAILY_AI_REQUEST_LIMIT=60
GLOBAL_DAILY_AI_REQUEST_LIMIT=300
AI_MAX_CONCURRENT_REQUESTS=2
PROVIDER_TIMEOUT_MS=90000

# External LLM: keep credentials server-side in an ignored .env file.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=json_schema
LLM_TOKEN_PARAMETER=max_completion_tokens
# Providers without strict schemas can use json_object; local validation remains mandatory.
# Older compatible APIs can use LLM_TOKEN_PARAMETER=max_tokens.

# Local Codex: version 0.162.1 was verified with this adapter.
CODEX_BINARY=codex
CODEX_MODEL=gpt-5.6-luna
# Defaults to the service user's ~/.codex/auth.json. Use an absolute path if needed.
# CODEX_AUTH_PATH=/home/ubuntu/.codex/auth.json
